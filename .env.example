# Password for the admin dashboard at /admin
ADMIN_PASSWORD=change-me
# Secret used to sign admin login sessions (required on Vercel). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it (local only) a random secret is used and restarting the server logs you out.
# SESSION_SECRET=
# Port for the API / production server
PORT=3001
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…) so login rate limiting sees real IPs
# TRUST_PROXY=1
# Set to 0 only when testing the production build locally over plain http
# FORCE_HTTPS=0
# Vercel Blob: when set, content and images are stored in Blob instead of server/content.json and server/uploads/.
# Vercel sets this (or BLOB_STORE_ID, for OIDC auth) automatically when a Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=
# Access type of the Blob store: private (default) or public — must match how the store was created
# BLOB_ACCESS=private
